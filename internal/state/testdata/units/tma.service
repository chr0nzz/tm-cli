[Unit]
Description=Traefik Manager Agent
After=network.target

[Service]
Type=simple
Environment=TMA_API_KEY=tma-api-key-PLACEHOLDER
Environment=TRAEFIK_API_URL=https://traefik.example.com:8443
Environment=TRAEFIK_API_USER=admin
Environment=TRAEFIK_API_PASSWORD=traefik-api-password-PLACEHOLDER
Environment=CONFIG_PATH=/etc/traefik/dynamic
Environment=TRAEFIK_INSECURE_SKIP_VERIFY=true
Environment=STATIC_CONFIG_PATH=/etc/traefik/traefik.yml
Environment=RESTART_METHOD=socket
Environment=TRAEFIK_CONTAINER=traefik
Environment=ACME_JSON_PATH=/etc/traefik/acme.json
Environment=ACCESS_LOG_PATH=/var/log/traefik/access.log
Environment=PLUGINS_DIR=/etc/traefik/plugins
Environment=CROWDSEC_LAPI_URL=http://10.0.0.5:8080
Environment=CROWDSEC_API_KEY=crowdsec-api-key-PLACEHOLDER
Environment=GIT_BACKUP_ENABLED=true
Environment=GIT_BACKUP_REPO=https://github.com/example/traefik-config.git
Environment=GIT_BACKUP_BRANCH=main
Environment=GIT_BACKUP_USERNAME=deploy
Environment=GIT_BACKUP_TOKEN=git-backup-token-PLACEHOLDER
Environment=GIT_BACKUP_AUTO_PUSH=true
Environment=TMA_PORT=8095

ExecStart=/usr/local/bin/tma
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
