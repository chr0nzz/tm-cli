[Unit]
Description=Traefik Manager Agent
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/traefik-manager-agent/env
Environment="TRAEFIK_API_URL=http://localhost:8080"
Environment="CONFIG_PATH=/etc/traefik/conf.d"
Environment="RESTART_METHOD=proxy"
Environment="TRAEFIK_CONTAINER=traefik"
Environment="DOCKER_HOST=tcp://127.0.0.1:2375"
Environment="ACME_JSON_PATH=/etc/traefik/acme.json"
Environment="TMA_PORT=8090"
ExecStart=/usr/local/bin/tma
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
